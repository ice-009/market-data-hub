# Copy to .env (never commit it). Everything here stays on the machine running the hub.

# --- Server
HUB_HOST=127.0.0.1           # loopback only; the Cloudflare Tunnel is the way in
HUB_PORT=8787
HUB_DATA_DIR=./data          # SQLite database and broker token cache
HUB_LOG_LEVEL=info           # debug | info | warn | error
HUB_KEY_RATE_PER_MINUTE=600  # requests per minute per API key
HUB_JOBS=on                  # background jobs: NSE files in the evening IST, queued backfills (off = none)
HUB_FETCH_WAIT_MS=20000      # how long /v1/candles waits for missing data from the broker before a 503

# --- Broker (Fyers API v3, data only). Without it the hub serves only what is stored
# plus the NSE datasets (which need no broker).
FYERS_CLIENT_ID=             # App ID, e.g. ABCD1234EF-100
FYERS_SECRET_KEY=
FYERS_FY_ID=                 # your Fyers login ID
FYERS_PIN=                   # 4-digit PIN
FYERS_TOTP_SECRET=           # base32 TOTP seed (not a 6-digit code)
FYERS_PLAN=standard          # standard | prime — sets the request budget
FYERS_REDIRECT_URL=          # the redirect URL registered for your Fyers app (default http://localhost:3000/api/broker/callback)
# FYERS_API_URL / FYERS_DATA_URL override the Fyers endpoints (tests point them at a mock server).
# NSE_ARCHIVE_URL / NSE_WWW_URL do the same for NSE.

# --- Cloudflare Tunnel (only for `docker compose --profile tunnel`)
TUNNEL_TOKEN=
